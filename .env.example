# ==============================================================================
# GSS_LOGISTICS ENVIRONMENT CONFIGURATION TEMPLATE
# Copy file này thành .env và điền các giá trị thực tế của môi trường
# ==============================================================================

# 1. Django Core Security
# Sinh secret key bảo mật: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Bắt buộc khi DEBUG=False. Tạo bằng: python -c "import secrets;print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,gss-logistics.example.com

# 2. CORS & CSRF Whitelist (Phân tách bằng dấu phẩy)
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://gss-logistics.example.com,http://gss-logistics.example.com,http://localhost:8086,http://127.0.0.1:8086,http://localhost:8000,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=https://gss-logistics.example.com,http://gss-logistics.example.com,http://localhost:8086,http://127.0.0.1:8086,http://localhost:8000,http://127.0.0.1:8000

# 3. Database Connection (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=gss_logistics_db
DB_USER=gss_logistics_user
DB_PASSWORD=doi-mat-khau-manh-o-day
DB_HOST=127.0.0.1
DB_PORT=5436

# 4. HTTPS & Cookie Security (Chỉ kích hoạt khi lên Production với HTTPS)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Frontend: true = nạp từng module JS riêng (dev), false = nạp app.js đã ghép (production)
FRONTEND_SPLIT_SCRIPTS=false

# 5. Bảo mật bổ sung
# Nginx có location /protected-media/ (xem scripts/nginx_gss_logistics.conf)
MEDIA_USE_X_ACCEL=false
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900

# Loại hình doanh nghiệp của công ty tạo lần đầu: GSS_VENDOR_DEPOT_QR | INTERNAL_FLEET_PNL | ENTERPRISE_FULL
DEFAULT_BUSINESS_MODEL=GSS_VENDOR_DEPOT_QR

# Row-Level Security PostgreSQL (core/rls.py). Tắt khẩn cấp: TENANT_RLS=false
TENANT_RLS=true
DB_RLS_ROLE=gss_rls
