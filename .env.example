# ==============================================================================
# BIM_LOGISTICS ENVIRONMENT CONFIGURATION TEMPLATE
# Copy file này thành .env và điền các giá trị thực tế của môi trường
# ==============================================================================

# 1. Django Core Security
# Sinh secret key bảo mật: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Bắt buộc khi DEBUG=False. Tạo bằng: python -c "import secrets;print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,logistics.bim.info.vn,bim.info.vn,149.118.60.194

# 2. CORS & CSRF Whitelist (Phân tách bằng dấu phẩy)
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://logistics.bim.info.vn,http://logistics.bim.info.vn,https://bim.info.vn,http://bim.info.vn,http://149.118.60.194:8085,http://localhost:8085,http://127.0.0.1:8085,http://localhost:8000,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=https://logistics.bim.info.vn,http://logistics.bim.info.vn,https://bim.info.vn,http://bim.info.vn,http://149.118.60.194:8085,http://localhost:8085,http://127.0.0.1:8085,http://localhost:8000,http://127.0.0.1:8000

# 3. Database Connection (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=bim_logistics_db
DB_USER=bim_logistics_user
DB_PASSWORD=doi-mat-khau-manh-o-day
DB_HOST=127.0.0.1
DB_PORT=5435

# 4. HTTPS & Cookie Security (Chỉ kích hoạt khi lên Production với HTTPS)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Frontend: true = nạp từng module JS riêng (dev), false = nạp app.js đã ghép (production)
FRONTEND_SPLIT_SCRIPTS=false

# 5. Bảo mật bổ sung
# HASHIDS_SALT: đổi giá trị sẽ làm các link tài xế/tra cứu cũ không mở được nữa
HASHIDS_SALT=
# Nginx có location /protected-media/ (xem scripts/nginx_bim_logistics.conf)
MEDIA_USE_X_ACCEL=false
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
